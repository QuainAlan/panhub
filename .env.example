# 环境变量示例（复制为 .env 后修改）

# 日志级别：debug | info | warn | error
LOG_LEVEL=debug

# wx-auth 认证服务地址（唯一登录通道：小程序 Bearer token 与
# 网页端公众号 cookie 均转发该服务的 /api/auth/check 校验）
WX_AUTH_API_BASE=https://wx-auth.shenzjd.com

# 可选：显式声明前置了可信反向代理（Cloudflare / nginx 等，值为 1）。
# 声明后才信任 CF-Connecting-IP / X-Forwarded-For 头解析客户端 IP（限流用）；
# 默认不信任任何代理头，Docker 直连场景无需配置。
# TRUST_PROXY=1
